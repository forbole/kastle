+/// Signs only if the intended UTF-8 memo is encrypted into the actual recipient
+/// output of the bundle. This binds deposit references to the payment signature.
+#[wasm_bindgen]
+pub fn verify_and_sign_payment_with_memo(
+    seed_hex: &str,
+    network: &str,
+    to_address: &str,
+    amount_sompi: u64,
+    max_fee_sompi: u64,
+    memo: &str,
+    bundle_hex: &str,
+    disclosure_json: &str,
+    alphas_json: &str,
+) -> Result<String, String> {
+    verify_and_sign_payment_inner(seed_hex, network, to_address, amount_sompi, max_fee_sompi, Some(memo), bundle_hex, disclosure_json, alphas_json)
+}
+
+fn verify_recipient_memo(
+    bundle: &kaspa_shielded_core::bundle::ShieldedBundle,
+    disclosure: &[kaspa_shielded_core::payment_check::ActionDisclosure],
+    fvk_bytes: &[u8; 96],
+    to: &[u8; 43],
+    amount: u64,
+    memo: &str,
+) -> Result<(), String> {
+    use kaspa_shielded_core::payment_check::check_prepared_payment;
+    use orchard::{
+        keys::FullViewingKey,
+        note::{Note, NoteVersion, RandomSeed, Rho},
+        note_encryption::{OrchardDomain, OrchardNoteEncryption},
+        value::NoteValue,
+    };
+    use zcash_note_encryption::Domain;
+
+    let utf8 = memo.as_bytes();
+    if utf8.len() > 512 {
+        return Err("memo exceeds 512 UTF-8 bytes".to_string());
+    }
+    let mut padded = [0u8; 512];
+    padded[..utf8.len()].copy_from_slice(utf8);
+
+    // The same full value/recipient/commitment check as the SDK signer, but
+    // before any signature exists. It also requires exactly one recipient note.
+    let fee = u64::try_from(bundle.value_balance).map_err(|_| "invalid fee".to_string())?;
+    let fvk = FullViewingKey::from_bytes(fvk_bytes).ok_or("invalid viewing key")?;
+    check_prepared_payment(bundle, disclosure, &fvk, to, amount, fee)
+        .map_err(|e| e.to_string())?;
+
+    let (action, output) = bundle.actions.iter().zip(disclosure).find(|(_, d)| {
+        d.out_recipient == *to && d.out_value == amount
+    }).ok_or("recipient note is missing")?;
+    let rho = Option::<Rho>::from(Rho::from_bytes(&action.nullifier))
+        .ok_or("invalid recipient rho")?;
+    let rseed = Option::<RandomSeed>::from(RandomSeed::from_bytes(output.out_rseed, &rho))
+        .ok_or("invalid recipient random seed")?;
+    let recipient = Option::<orchard::Address>::from(
+        orchard::Address::from_raw_address_bytes(&output.out_recipient),
+    ).ok_or("invalid recipient address")?;
+    let note = Option::<Note>::from(Note::from_parts(
+        recipient, NoteValue::from_raw(output.out_value), rho, rseed, NoteVersion::V2,
+    )).ok_or("invalid recipient note")?;
+    // Orchard v2 derives its ephemeral secret from this committed note. Rebuild
+    // the exact recipient ciphertext and compare it with the signed bundle.
+    let encryptor = OrchardNoteEncryption::new(None, note, padded);
+    if OrchardDomain::epk_bytes(encryptor.epk()).0 != action.ephemeral_key
+        || encryptor.encrypt_note_plaintext() != action.enc_ciphertext
+    {
+        return Err("prepared payment memo does not match the approved memo".to_string());
+    }
+    Ok(())
+}
