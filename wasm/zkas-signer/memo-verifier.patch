+    fn memo_payment(memo: &str, to: [u8; 43]) -> (ShieldedBundle, Vec<ActionDisclosure>, [u8; 96]) {
+        let signer = zkas_signer::SoftwareSigner::new([1; 32]).unwrap();
+        let nullifier = [1u8; 32];
+        let rho = Option::<Rho>::from(Rho::from_bytes(&nullifier)).unwrap();
+        let rseed_bytes = [7u8; 32];
+        let rseed = Option::<RandomSeed>::from(RandomSeed::from_bytes(rseed_bytes, &rho)).unwrap();
+        let recipient = Option::<orchard::Address>::from(orchard::Address::from_raw_address_bytes(&to)).unwrap();
+        let note = Option::<Note>::from(Note::from_parts(recipient, NoteValue::from_raw(100), rho, rseed, NoteVersion::V2)).unwrap();
+        let mut padded = [0u8; 512];
+        padded[..memo.len()].copy_from_slice(memo.as_bytes());
+        let encryptor = OrchardNoteEncryption::new(None, note, padded);
+        let rcv_bytes = [3u8; 32];
+        let rcv = Option::<ValueCommitTrapdoor>::from(ValueCommitTrapdoor::from_bytes(rcv_bytes)).unwrap();
+        let action = ActionWire {
+            nullifier,
+            cmx: ExtractedNoteCommitment::from(note.commitment()).to_bytes(),
+            cv_net: ValueCommitment::derive(NoteValue::from_raw(110) - NoteValue::from_raw(100), rcv).to_bytes(),
+            rk: [0; 32],
+            ephemeral_key: OrchardDomain::epk_bytes(encryptor.epk()).0,
+            enc_ciphertext: encryptor.encrypt_note_plaintext(),
+            out_ciphertext: [0; 80],
+            spend_auth_sig: [0; 64],
+        };
+        let bundle = ShieldedBundle {
+            actions: vec![action],
+            flags: 3,
+            value_balance: 10,
+            anchor: [0; 32],
+            proof: Vec::new(),
+            binding_sig: [0; 64],
+            burn: None,
+        };
+        let disclosure = vec![ActionDisclosure {
+            spend_value: 110,
+            out_value: 100,
+            out_recipient: to,
+            out_rseed: rseed_bytes,
+            rcv: rcv_bytes,
+        }];
+        (bundle, disclosure, signer.full_viewing_key())
+    }
