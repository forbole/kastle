+    #[test]
+    fn intended_memo_is_bound_to_recipient_ciphertext() {
+        let recipient = zkas_signer::SoftwareSigner::new([2; 32]).unwrap().address_bytes();
+        let (bundle, disclosure, fvk) = memo_payment(" exchange 42\n", recipient);
+        assert!(verify_recipient_memo(&bundle, &disclosure, &fvk, &recipient, 100, " exchange 42\n").is_ok());
+        for memo in ["exchange 42\n", " exchange 43\n", ""] {
+            assert!(verify_recipient_memo(&bundle, &disclosure, &fvk, &recipient, 100, memo).is_err());
+        }
+        let mut ciphertext_mutated = bundle.clone();
+        ciphertext_mutated.actions[0].enc_ciphertext[12] ^= 1;
+        assert!(verify_recipient_memo(&ciphertext_mutated, &disclosure, &fvk, &recipient, 100, " exchange 42\n").is_err());
+        let mut epk_mutated = bundle.clone();
+        epk_mutated.actions[0].ephemeral_key[0] ^= 1;
+        assert!(verify_recipient_memo(&epk_mutated, &disclosure, &fvk, &recipient, 100, " exchange 42\n").is_err());
+        assert!(verify_recipient_memo(&bundle, &disclosure, &fvk, &recipient, 101, " exchange 42\n").is_err());
+        assert!(verify_recipient_memo(&bundle, &[], &fvk, &recipient, 100, " exchange 42\n").is_err());
+    }
+
+    #[test]
+    fn memo_limits_empty_and_self_send() {
+        let signer = zkas_signer::SoftwareSigner::new([1; 32]).unwrap();
+        let self_address = signer.address_bytes();
+        for memo in ["", &"é".repeat(256)] {
+            let (bundle, disclosure, fvk) = memo_payment(memo, self_address);
+            assert!(verify_recipient_memo(&bundle, &disclosure, &fvk, &self_address, 100, memo).is_ok());
+        }
+        let (bundle, disclosure, fvk) = memo_payment("", self_address);
+        assert!(verify_recipient_memo(&bundle, &disclosure, &fvk, &self_address, 100, &"a".repeat(513)).is_err());
+    }
